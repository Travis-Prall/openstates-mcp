# OpenStates MCP Server - example environment file
#
# Copy this to `.env` and set a real API key:
#
#     cp .env.example .env
#
# Get a key at https://openstates.org/accounts/profile/

# Required: OpenStates API v3 key. Every tool call is authenticated with it.
OPENSTATES_API_KEY=your-api-key-here

# ---------------------------------------------------------------------------
# OpenStates API client (defaults shown)
# ---------------------------------------------------------------------------
OPENSTATES_BASE_URL=https://v3.openstates.org
OPENSTATES_LOG_LEVEL=INFO
OPENSTATES_TIMEOUT=30
OPENSTATES_CONNECT_TIMEOUT=10
OPENSTATES_READ_TIMEOUT=30
OPENSTATES_MAX_RETRIES=3
OPENSTATES_RETRY_DELAY=1.0
OPENSTATES_RATE_LIMIT=50
OPENSTATES_CACHE_TTL=300
OPENSTATES_DEBUG=false

# ---------------------------------------------------------------------------
# MCP server
# ---------------------------------------------------------------------------
MCP_HOST=0.0.0.0
MCP_PORT=8797
MCP_PATH=/mcp/
# streamable-http (default), http or stdio
MCP_TRANSPORT=streamable-http
# Fresh session per request, for horizontal scaling behind a load balancer
MCP_STATELESS_HTTP=false

# ---------------------------------------------------------------------------
# Security allow lists
#
# Empty values disable the check, which is right for local and non-browser
# clients. Set comma separated values for internet-facing deployments.
# ---------------------------------------------------------------------------
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
MCP_CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Directory for rotating log files (defaults to app/logs). Inside a container
# with a read-only root filesystem use a writable path such as /tmp/logs.
# LOG_DIR=/tmp/logs
